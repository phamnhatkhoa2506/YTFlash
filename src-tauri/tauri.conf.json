{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTFlash",
  "version": "0.2.0",
  "identifier": "com.khoap.ytflash",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YTFlash",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/yt-dlp.exe": "binaries/yt-dlp.exe",
      "binaries/ffmpeg.exe": "binaries/ffmpeg.exe",
      "binaries/plugins": "binaries/plugins",
      "binaries/bgutil-provider": "binaries/bgutil-provider"
    }
  }
}
